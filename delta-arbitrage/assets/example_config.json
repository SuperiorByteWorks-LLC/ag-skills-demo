{
  "description": "Example configuration for Delta Arbitrage Skill",
  "notes": "Copy this to your project root as config.json and customize",

  "kalshi_api_key": "YOUR_KALSHI_API_KEY_HERE",
  "kalshi_private_key_path": "./private_key.pem",

  "zmq_bind_address": "tcp://127.0.0.1:5555",
  "graph_output_path": "./pipeline/data/graph.json",

  "similarity_threshold": 0.7,
  "time_window_days": 30,
  "max_time_candidates": 200,

  "embedding_model": "all-MiniLM-L6-v2",
  "cluster_count": "auto",
  "cluster_interval_seconds": 60,
  "cluster_event_interval": 1000,

  "monitoring": {
    "alert_on_high_confidence": true,
    "confidence_threshold": 0.85,
    "min_disparity_alert": 0.1,
    "check_interval_seconds": 60
  },

  "export": {
    "default_format": "json",
    "auto_export": false,
    "export_interval_minutes": 60,
    "output_directory": "./exports"
  },

  "visualization": {
    "default_theme": "dark",
    "default_width": 1200,
    "default_height": 800,
    "show_arbitrage_only": false
  }
}
